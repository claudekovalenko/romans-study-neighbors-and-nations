  "weeks": [
    {
      "title": "Set Apart for the Gospel",
      "passage": "Romans 1:1-17",
      "preacher": "",
      "summary": "SAMPLE WEEK — replace with your own. Paul introduces himself, his calling, and the gospel he has been set apart to proclaim among all the nations.",
      "bigIdea": "The gospel is the power of God for salvation to everyone who believes.",
      "videos": {
        "before": "",
        "after": ""
      },
      "podcastEpisodeUrl": "",
      "questions": [
        "What does Paul say the gospel is about (1:3-4)?",
        "Why is Paul not ashamed of the gospel (1:16)?",
        "Who are the neighbors and nations God is placing on your heart this week?"
      ],
      "days": [
        {
          "passage": "Romans 1:1-7",
          "title": "Called and set apart",
          "prompt": "How does Paul describe himself? What would change if you saw yourself the same way?"
        },
        {
          "passage": "Romans 1:8-15",
          "title": "Longing to see you",
          "prompt": "What does Paul pray for the church in Rome? Pray the same for someone today."
        },
        {
          "passage": "Romans 1:16-17",
          "title": "Not ashamed",
          "prompt": "Where are you tempted to be quiet about Jesus?"
        },
        {
          "passage": "Acts 28:11-31",
          "title": "Paul arrives in Rome",
          "prompt": "Notice how Paul spends his time in Rome. What stands out?"
        },
        {
          "passage": "Psalm 98",
          "title": "Salvation made known to the nations",
          "prompt": "Read this aloud as a prayer for the nations."
        },
        {
          "passage": "Romans 1:1-17",
          "title": "Read it all again",
          "prompt": "Read the whole passage slowly. Write down one question to bring on Sunday."
        }
      ]
    },
